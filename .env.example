# Copy to .env.local for local dev. NEVER commit .env or .env.local.

# ── Supabase ─────────────────────────────────────────────────────────────
# Get these from your Supabase project's API settings.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-only — never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# DB password — required for `npm run supabase:link` / `npm run supabase:migrate` (hosted project, no Docker).
SUPABASE_DB_PASSWORD=your-db-password

# ── App ──────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=Bantu Niaga

# Deployment mode: `saas` (default, multi-tenant sign-up) or `standalone`
# (single business per install — hides sign-up after first bootstrap).
DEPLOYMENT_MODE=saas
NEXT_PUBLIC_DEPLOYMENT_MODE=saas

# Optional — pin the tenant UUID for standalone scripts / data import.
# STANDALONE_BUSINESS_ID=

# Set to true once Supabase SMTP or Resend is configured for sign-up emails.
# AUTH_REQUIRE_EMAIL_VERIFICATION=true

# ── AI ───────────────────────────────────────────────────────────────────
# ILMU (YTL AI Labs) — powers all AI agents. Set in production `.env`.
# ILMU_API_KEY=sk-...
# ILMU_DEFAULT_MODEL=ilmu-mini-v3.3
# ILMU_API_BASE_URL=https://api.ilmu.ai/v1

# ── Platform encryption ──────────────────────────────────────────────────
# Used for HR sensitive fields, tenant webhook secrets, and API key pepper.
# Generate with: openssl rand -hex 32
# CRITICAL: do not rotate casually — existing sealed data becomes unreadable.
INTEGRATION_ENCRYPTION_KEY=change-me-to-a-32-byte-hex-string

# ── Payments (Billplz) ───────────────────────────────────────────────────
# Platform Billplz — enables Settings top-ups AND Finance invoice "Pay online".
# When all three are set, public invoices show FPX/card checkout; webhook auto-marks paid.
# BILLPLZ_API_KEY=
# BILLPLZ_X_SIGNATURE_KEY=   # required for webhook auto-complete
# BILLPLZ_COLLECTION_ID=
# BILLPLZ_SANDBOX=true       # optional — use Billplz sandbox API

# ── Email (Resend) ───────────────────────────────────────────────────────
# Transactional email + Marketing > Broadcasts email channel.
# RESEND_API_KEY=
# MARKETING_FROM_EMAIL=no-reply@yourdomain.com

# ── Analytics (Google Analytics 4) ───────────────────────────────────────
# Marketing site page views and conversions.
# GA4_MEASUREMENT_ID=G-XXXXXXXXXX
# GA4_API_SECRET=              # optional — Measurement Protocol server events

# ── Storage (Cloudflare R2) ──────────────────────────────────────────────
# Optional S3-compatible storage for tenant uploads beyond Supabase quota.
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET=

# ── Meta (Facebook + Instagram Business) integration (Marketing M7) ──────
# Create a Meta App at https://developers.facebook.com/apps/ (no fees).
# Add the products "Facebook Login for Business" and "Instagram Graph API".
# Under "Use cases" enable: pages_show_list, pages_read_engagement,
# pages_manage_posts, pages_read_user_content, instagram_basic,
# instagram_content_publish, instagram_manage_insights, business_management.
# The OAuth redirect URI MUST exactly match META_REDIRECT_URI in
# App Settings → Use cases → Facebook Login → Valid OAuth Redirect URIs.
#
# Server-only secrets — never expose to the browser.
# META_APP_ID=
# META_APP_SECRET=
# META_REDIRECT_URI=http://localhost:3000/api/social/meta/callback
# If META_REDIRECT_URI is omitted, the app derives it from
# NEXT_PUBLIC_APP_URL + "/api/social/meta/callback".

# ── PDPA / Privacy ───────────────────────────────────────────────────────
# Privacy notice version string captured against every consent grant.
# Bump this whenever the wording in app/legal/privacy/page.tsx materially
# changes so we can prove which version each user actually consented to.
PRIVACY_POLICY_VERSION=2026-06-14

# Required for /api/cron/privacy-sweep — the hourly worker that hard-deletes
# accounts past their 30-day grace window. Generate with
#   openssl rand -hex 32
# Vercel Cron auto-attaches this as `Authorization: Bearer $CRON_SECRET`
# when the env var is configured in your project.
CRON_SECRET=change-me-to-a-32-byte-hex-string
